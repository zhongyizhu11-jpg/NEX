  {
    "name": "auto-peak-ewma-avoids-a-latency-spike",
    "about": "自动（P2C + peak EWMA）：一个成员的延迟突然飙高，几条连接之内它的份额掉到一成以下；之后探测照样来，正常的样本把尖峰落回去，它又分得到，不会饿死",
    "strategy": "auto",
    "members": [{ "name": "a" }, { "name": "b" }],
    "steps": [
      {
        "about": "两个都是 20ms：一人一半",
        "latency": { "a": [[10, 20], [5, 20], [0, 20]], "b": [[10, 20], [5, 20], [0, 20]] },
        "picks": 40,
        "mode": "burst",
        "expect": { "counts": { "a": [18, 22], "b": [18, 22] } }
      },
      {
        "about": "b 刚量到一次 2000ms：读数立刻跳上去，接下来 40 条里它最多拿 3 条（不到一成）",
        "latency": { "a": [[10, 20], [5, 20], [0, 20]], "b": [[10, 20], [5, 20], [0, 2000]] },
        "picks": 40,
        "mode": "burst",
        "expect": { "counts": { "a": [37, 40], "b": [0, 3] } }
      },
      {
        "about": "尖峰过去 60 秒，这期间没人用 b，但探测照样给它新样本（都是 20ms）；读数从尖峰落回来了，又分得到连接",
        "latency": { "a": [[10, 20], [5, 20], [0, 20]], "b": [[65, 20], [60, 2000], [55, 20], [30, 20], [0, 20]] },
        "picks": 40,
        "mode": "burst",
        "expect": { "counts": { "b": [12, 40] } }
      }
    ]
  },
  {
    "name": "latency-near-set",
