+// nexHopSelector is implemented by hops that can tell a deliberate direct route (bypass matched,
+// no eligible node) from a failed selection (NEX, nex-selector-noempty.patch).
+type nexHopSelector interface {
+	NexSelect(ctx context.Context, opts ...hop.SelectOption) (node *chain.Node, direct bool)
+}
