--- /dev/null
+++ b/selector/nex_noempty_test.go
@@ -0,0 +1,48 @@
+package selector
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/go-gost/core/chain"
+	"github.com/go-gost/core/selector"
+)
+
+// NEX: with every node inside its fail window the fail filter must not return an empty list
+// (an empty selection makes a chain dial the target directly), see nex-selector-noempty.patch.
+func TestNexFailFilterNeverEmpty(t *testing.T) {
+	a := chain.NewNode("a", "127.0.0.1:1")
+	b := chain.NewNode("b", "127.0.0.1:2")
+	f := FailFilter[*chain.Node](1, 15*time.Second)
+	ctx := context.Background()
+
+	if got := f.Filter(ctx, a, b); len(got) != 2 {
+		t.Fatalf("healthy nodes: got %d, want 2", len(got))
+	}
+	a.Marker().Mark()
+	if got := f.Filter(ctx, a, b); len(got) != 1 || got[0] != b {
+		t.Fatalf("one failed node: got %v, want only b", got)
+	}
+	b.Marker().Mark()
+	got := f.Filter(ctx, a, b)
+	if len(got) != 2 || got[0] != a || got[1] != b {
+		t.Fatalf("all nodes failed: got %v, want both nodes in order", got)
+	}
+
+	for name, strategy := range map[string]selector.Strategy[*chain.Node]{
+		"round":  RoundRobinStrategy[*chain.Node](),
+		"random": RandomStrategy[*chain.Node](),
+		"fifo":   FIFOStrategy[*chain.Node](),
+		"hash":   HashStrategy[*chain.Node](),
+	} {
+		s := NewSelector(strategy, f, BackupFilter[*chain.Node]())
+		if s.Select(ctx, a, b) == nil {
+			t.Fatalf("%s: selected nothing with all nodes failed", name)
+		}
+	}
+	// fifo keeps the configured order: the first node is tried first once all are failed.
+	if n := NewSelector(FIFOStrategy[*chain.Node](), f).Select(ctx, a, b); n != a {
+		t.Fatalf("fifo with all nodes failed: got %v, want a", n)
+	}
+}
