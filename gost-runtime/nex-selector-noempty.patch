+package chain_test
+
+import (
+	"context"
+	"errors"
+	"net"
+	"testing"
+
+	"github.com/go-gost/core/bypass"
+	"github.com/go-gost/core/chain"
+	"github.com/go-gost/core/connector"
+	"github.com/go-gost/core/hop"
+	xchain "github.com/go-gost/x/chain"
+	xhop "github.com/go-gost/x/hop"
+	xlogger "github.com/go-gost/x/logger"
+)
+
+// A selector that selects nothing: what the upstream fail filter made the real selector do while
+// every node was inside its fail window.
+type nexNilSelector struct{}
+
+func (nexNilSelector) Select(context.Context, ...*chain.Node) *chain.Node { return nil }
+
+type nexMatchAll struct{}
+
+func (nexMatchAll) IsWhitelist() bool { return false }
+func (nexMatchAll) Contains(context.Context, string, string, ...bypass.Option) bool {
+	return true
+}
+
+// A stand-in for a relay hop that reaches the target when asked to: if the route ended at this
+// node, the dial would succeed and the target would see a connection.
+type nexRelayTransport struct{ target string }
+
+func (tr *nexRelayTransport) Dial(ctx context.Context, addr string) (net.Conn, error) {
+	return net.Dial("tcp", tr.target)
+}
+func (tr *nexRelayTransport) Handshake(ctx context.Context, conn net.Conn) (net.Conn, error) {
+	return conn, nil
+}
+func (tr *nexRelayTransport) Connect(ctx context.Context, conn net.Conn, network, address string) (net.Conn, error) {
+	return conn, nil
+}
+func (tr *nexRelayTransport) Bind(ctx context.Context, conn net.Conn, network, address string, opts ...connector.BindOption) (net.Listener, error) {
+	return nil, errors.New("not supported")
+}
+func (tr *nexRelayTransport) Multiplex() bool                  { return false }
+func (tr *nexRelayTransport) Options() *chain.TransportOptions { return &chain.TransportOptions{} }
+func (tr *nexRelayTransport) Copy() chain.Transporter          { return tr }
+
+func nexTarget(t *testing.T) (addr string, accepted chan struct{}) {
+	t.Helper()
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { ln.Close() })
+	accepted = make(chan struct{}, 8)
+	go func() {
+		for {
+			c, err := ln.Accept()
+			if err != nil {
+				return
+			}
+			accepted <- struct{}{}
+			c.Close()
+		}
+	}()
+	return ln.Addr().String(), accepted
+}
+
+// NEX: a hop with eligible nodes that selects none must fail the dial, never fall back to a direct
+// dial of the target (nex-selector-noempty.patch).
+func TestNexChainWithoutSelectedNodeDoesNotDialDirect(t *testing.T) {
+	target, accepted := nexTarget(t)
+	ctx := context.Background()
+
+	for _, tc := range []struct {
+		name string
+		hops int
+	}{{"single hop", 1}, {"second hop of two", 2}} {
+		c := xchain.NewChain("c")
+		if tc.hops == 2 {
+			c.AddHop(xhop.NewHop(xhop.NodeOption(chain.NewNode("relay", "127.0.0.1:1",
+				chain.TransportNodeOption(&nexRelayTransport{target: target})))))
+		}
+		c.AddHop(xhop.NewHop(
+			xhop.NodeOption(chain.NewNode("a", "127.0.0.1:1"), chain.NewNode("b", "127.0.0.1:2")),
+			xhop.SelectorOption(nexNilSelector{}),
+		))
+		route := c.Route(ctx, "tcp", target)
+		if route == nil {
+			t.Fatalf("%s: nil route (the router dials a nil route directly)", tc.name)
+		}
+		if n := len(route.Nodes()); n != 0 {
+			t.Fatalf("%s: route has %d nodes, want none", tc.name, n)
+		}
+		conn, err := route.Dial(ctx, "tcp", target, chain.LoggerDialOption(xlogger.Nop()))
+		if conn != nil {
+			conn.Close()
+		}
+		if !errors.Is(err, xchain.ErrNexNoNode) {
+			t.Fatalf("%s: dial err = %v, want ErrNexNoNode", tc.name, err)
+		}
+		if _, err := route.Bind(ctx, "tcp", "127.0.0.1:0"); !errors.Is(err, xchain.ErrNexNoNode) {
+			t.Fatalf("%s: bind err = %v, want ErrNexNoNode", tc.name, err)
+		}
+	}
+	select {
+	case <-accepted:
+		t.Fatal("target was dialed directly")
+	default:
+	}
+}
+
+// The deliberate direct paths stay: a hop-level bypass, or every node excluded by its own bypass.
+func TestNexChainBypassStillDialsDirect(t *testing.T) {
+	target, accepted := nexTarget(t)
+	ctx := context.Background()
+
+	hopBypass := xhop.NewHop(
+		xhop.NodeOption(chain.NewNode("a", "127.0.0.1:1"), chain.NewNode("b", "127.0.0.1:2")),
+		xhop.SelectorOption(nexNilSelector{}),
+		xhop.BypassOption(nexMatchAll{}),
+	)
+	nodeBypass := xhop.NewHop(
+		xhop.NodeOption(
+			chain.NewNode("a", "127.0.0.1:1", chain.BypassNodeOption(nexMatchAll{})),
+			chain.NewNode("b", "127.0.0.1:2", chain.BypassNodeOption(nexMatchAll{})),
+		),
+		xhop.SelectorOption(nexNilSelector{}),
+	)
+	nexChainOf := func(h hop.Hop) *xchain.Chain {
+		c := xchain.NewChain("c")
+		c.AddHop(h)
+		return c
+	}
+	for name, h := range map[string]*xchain.Chain{
+		"hop bypass":  nexChainOf(hopBypass),
+		"node bypass": nexChainOf(nodeBypass),
+	} {
+		conn, err := h.Route(ctx, "tcp", target).Dial(ctx, "tcp", target, chain.LoggerDialOption(xlogger.Nop()))
+		if err != nil {
+			t.Fatalf("%s: direct dial failed: %v", name, err)
+		}
+		conn.Close()
+		<-accepted
+	}
+}
