+// NexSelect forwards to the registered hop (NEX, nex-selector-noempty.patch); see x/hop.
+// A hop that is not registered or does not report the reason behaves as upstream: nil is direct.
+func (w *hopWrapper) NexSelect(ctx context.Context, opts ...hop.SelectOption) (*chain.Node, bool) {
+	v := w.r.get(w.name)
+	if v == nil {
+		return nil, true
+	}
+	if s, ok := v.(interface {
+		NexSelect(ctx context.Context, opts ...hop.SelectOption) (*chain.Node, bool)
+	}); ok {
+		return s.NexSelect(ctx, opts...)
+	}
+	return v.Select(ctx, opts...), true
+}
