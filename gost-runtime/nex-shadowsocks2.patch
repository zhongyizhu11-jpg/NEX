-	hx := fnv.New64()
-	hx.Write(b)
-	x := hx.Sum64()
-	hy := fnv.New64a()
-	hy.Write(b)
-	y := hy.Sum64()
-	return x, y
+	return maphash.Bytes(bloomSeedX, b), maphash.Bytes(bloomSeedY, b) | 1
 }
 
