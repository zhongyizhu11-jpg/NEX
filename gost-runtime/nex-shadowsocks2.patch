+
+// targetPort (NEX) returns the port of a SOCKS address, 0 if it is too short.
+func targetPort(addr socks.Addr) int {
+	if len(addr) < 3 {
+		return 0
+	}
+	return int(addr[len(addr)-2])<<8 | int(addr[len(addr)-1])
+}
