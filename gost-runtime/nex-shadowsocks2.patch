diff -ruN a/shadowaead_2022/session_client.go b/shadowaead_2022/session_client.go
--- a/shadowaead_2022/session_client.go
+++ b/shadowaead_2022/session_client.go
@@ -26,6 +26,36 @@
 	lastUsed   atomic.Int64  // Last time this session was used (for timeout cleanup)
 	clientAddr netip.AddrPort
 	mu         sync.RWMutex
+
+	// NEX: replay protection for replies (SIP022: the client tracks the server's
+	// session ID and filters packet IDs with a sliding window). The current and the
+	// previous server session are kept so replies still in flight across a server
+	// restart are not dropped.
+	replayMu   sync.Mutex
+	serverCur  *serverReplayState
+	serverPrev *serverReplayState
+}
+
+type serverReplayState struct {
+	sessionID uint64
+	window    *SlidingWindow
+}
+
+// acceptServerPacket (NEX) reports whether a reply with this server session / packet ID
+// is new. Call it only after the packet authenticated.
+func (s *ClientSession) acceptServerPacket(serverSessionID, packetID uint64) bool {
+	s.replayMu.Lock()
+	defer s.replayMu.Unlock()
+	if s.serverCur != nil && s.serverCur.sessionID == serverSessionID {
+		return s.serverCur.window.Validate(packetID)
+	}
+	if s.serverPrev != nil && s.serverPrev.sessionID == serverSessionID {
+		return s.serverPrev.window.Validate(packetID)
+	}
+	state := &serverReplayState{sessionID: serverSessionID, window: NewSlidingWindow(0)}
+	state.window.Validate(packetID)
+	s.serverPrev, s.serverCur = s.serverCur, state
+	return true
 }
 
