@@ -0,0 +1,82 @@
+package shadowaead2022_test
+
+// NEX (nex-shadowsocks2.patch): replies to an SS2022 UDP client must be server packets that
+// echo this session's ID and carry a packet ID not seen before.
+
+import (
+	"encoding/base64"
+	"net/netip"
+	"testing"
+
+	"github.com/go-gost/go-shadowsocks2/core"
+	shadowaead2022 "github.com/go-gost/go-shadowsocks2/shadowaead_2022"
+	"github.com/go-gost/go-shadowsocks2/socks"
+	"github.com/go-gost/go-shadowsocks2/utils"
+)
+
+func TestNexSlidingWindowPacketZeroIsNotReplayable(t *testing.T) {
+	w := shadowaead2022.NewSlidingWindow(0)
+	if !w.Validate(0) {
+		t.Fatal("first packet 0 must be accepted")
+	}
+	if w.Validate(0) {
+		t.Fatal("packet 0 replayed must be rejected")
+	}
+	if !w.Validate(2) || !w.Validate(1) || w.Validate(1) || w.Validate(2) {
+		t.Fatal("out-of-order packets accepted once, replays rejected")
+	}
+}
+
+func TestNexClientRejectsForeignAndReplayedReplies(t *testing.T) {
+	for _, method := range []string{"2022-blake3-aes-128-gcm", "2022-blake3-aes-256-gcm"} {
+		t.Run(method, func(t *testing.T) {
+			size := 16
+			if method == "2022-blake3-aes-256-gcm" {
+				size = 32
+			}
+			key := make([]byte, size)
+			for i := range key {
+				key[i] = byte(i + 1)
+			}
+			cfg, err := utils.NewClientConfig(method, base64.StdEncoding.EncodeToString(key))
+			if err != nil {
+				t.Fatal(err)
+			}
+			client := core.NewUDPClient(cfg, 60)
+			target := socks.ParseAddr("1.1.1.1:443")
+			session, _, err := client.Inbound([]byte("hello"), netip.MustParseAddrPort("127.0.0.1:40000"), target)
+			if err != nil {
+				t.Fatal(err)
+			}
+			clientSID := session.(*shadowaead2022.ClientSession).SessionID()
+			reply := func(serverSID, packetID, echoed uint64) []byte {
+				pkt, err := shadowaead2022.PackUDP(cfg.Cipher, false, cfg.Cipher.Key(), cfg.Cipher.Key(), []byte("pong"), target, serverSID, packetID, echoed)
+				if err != nil {
+					t.Fatal(err)
+				}
+				return pkt
+			}
+			accept := func(name string, pkt []byte, want bool) {
+				t.Helper()
+				// Outbound decrypts in place: hand it a copy so a "replay" really is the same bytes.
+				payload, err := client.Outbound(append([]byte(nil), pkt...), session)
+				if want && (err != nil || string(payload) != "pong") {
+					t.Fatalf("%s: want accepted, got %q %v", name, payload, err)
+				}
+				if !want && err == nil {
+					t.Fatalf("%s: want rejected", name)
+				}
+			}
+			first := reply(7, 0, clientSID)
+			accept("first reply", first, true)
+			accept("replayed first reply", first, false)
+			accept("next packet", reply(7, 1, clientSID), true)
+			accept("other session's reply", reply(7, 2, clientSID+1), false)
+			accept("client-type packet", reply(7, 3, 0), false)
+			// Server restarted: a new server session is accepted; the previous one still works.
+			accept("new server session", reply(9, 0, clientSID), true)
+			accept("previous server session, new packet", reply(7, 5, clientSID), true)
+			accept("previous server session replay", reply(7, 1, clientSID), false)
+		})
+	}
+}
