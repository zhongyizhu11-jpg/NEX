diff -ruN a/internal/util/ss/nex_runt_test.go b/internal/util/ss/nex_runt_test.go
--- a/internal/util/ss/nex_runt_test.go
+++ b/internal/util/ss/nex_runt_test.go
@@ -0,0 +1,69 @@
+package ss
+
+import (
+	"encoding/base64"
+	"errors"
+	"net"
+	"os"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/go-gost/go-shadowsocks2/core"
+	"github.com/go-gost/go-shadowsocks2/utils"
+)
+
+// NEX (nex-ssu.patch): a spoofed short or garbage reply must be dropped, not crash the
+// runtime. Before the guard in ReadFrom a zero-length datagram panicked with
+// "slice bounds out of range" inside go-shadowsocks2.
+func TestNexRuntRepliesDoNotPanic(t *testing.T) {
+	for _, tc := range []struct{ method, password string }{
+		{"aes-256-gcm", "pw"},
+		{"chacha20-ietf-poly1305", "pw"},
+		{"2022-blake3-aes-128-gcm", base64.StdEncoding.EncodeToString(make([]byte, 16))},
+		{"2022-blake3-aes-256-gcm", base64.StdEncoding.EncodeToString(make([]byte, 32))},
+	} {
+		t.Run(tc.method, func(t *testing.T) {
+			cfg, err := utils.NewClientConfig(tc.method, tc.password)
+			if err != nil {
+				t.Fatal(err)
+			}
+			client := core.NewUDPClient(cfg, 60)
+			landing, err := net.ListenUDP("udp", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer landing.Close()
+			dialed, err := net.ListenUDP("udp", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer dialed.Close()
+			taddr := &net.UDPAddr{IP: net.IPv4(1, 1, 1, 1), Port: 53}
+			conn := UDPClientConn(dialed, landing.LocalAddr(), taddr, 0, &client, &sync.Map{}).SetClassicAEAD(tc.method[:5] != "2022-")
+			if _, err := conn.WriteTo([]byte("hello"), taddr); err != nil {
+				t.Fatal(err)
+			}
+			buf := make([]byte, 2048)
+			_, from, err := landing.ReadFromUDP(buf)
+			if err != nil {
+				t.Fatal(err)
+			}
+			// Runts of every length below and around the minimum, then random garbage.
+			for _, size := range []int{0, 1, 5, 15, 16, 17, 31, 32, 33, 48, 200} {
+				pkt := make([]byte, size)
+				for i := range pkt {
+					pkt[i] = byte(i*7 + size)
+				}
+				if _, err := landing.WriteToUDP(pkt, from); err != nil {
+					t.Fatal(err)
+				}
+			}
+			conn.SetReadDeadline(time.Now().Add(500 * time.Millisecond))
+			_, _, err = conn.ReadFrom(buf)
+			if !errors.Is(err, os.ErrDeadlineExceeded) {
+				t.Fatalf("expected all junk to be dropped until the deadline, got %v", err)
+			}
+		})
+	}
+}
