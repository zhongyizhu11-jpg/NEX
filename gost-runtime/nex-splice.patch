diff --git a/handler/forward/local/nex_unwrap.go b/handler/forward/local/nex_unwrap.go
new file mode 100644
index 0000000..1cf3c18
--- /dev/null
+++ b/handler/forward/local/nex_unwrap.go
@@ -0,0 +1,18 @@
+package local
+
+import "net"
+
+// nexUnwrap 剥掉声明自己可以被绕过的包装层（见 metrics/wrapper/nex_unwrap.go）。
+func nexUnwrap(c net.Conn) net.Conn {
+	for {
+		u, ok := c.(interface{ NEXUnwrap() net.Conn })
+		if !ok {
+			return c
+		}
+		inner := u.NEXUnwrap()
+		if inner == nil {
+			return c
+		}
+		c = inner
+	}
+}
diff --git a/metrics/wrapper/nex_unwrap.go b/metrics/wrapper/nex_unwrap.go
new file mode 100644
index 0000000..f35be2d
--- /dev/null
+++ b/metrics/wrapper/nex_unwrap.go
@@ -0,0 +1,16 @@
+package wrapper
+
+import (
+	"net"
+
+	xmetrics "github.com/go-gost/x/metrics"
+)
+
+// NEXUnwrap 让 NEX 的补丁拿到底层 TCP 连接、直接走 splice。只有没开 metrics 时这一层才是空转、
+// 可以被绕过；开了 metrics 就返回 nil，连接照旧走用户态，计数不丢。
+func (c *serverConn) NEXUnwrap() net.Conn {
+	if xmetrics.IsEnabled() {
+		return nil
+	}
+	return c.Conn
+}
