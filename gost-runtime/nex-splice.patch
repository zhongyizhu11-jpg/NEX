diff --git a/internal/net/nex_splice.go b/internal/net/nex_splice.go
--- /dev/null
+++ b/internal/net/nex_splice.go
@@ -0,0 +1,36 @@
+package net
+
+import "net"
+
+// NEXUnwrap 剥掉声明自己可以被绕过的包装层（实现 NEXUnwrap() net.Conn 的包装，见
+// metrics/wrapper/nex_unwrap.go）。包装层返回 nil 表示此刻不能绕过（例如 metrics 开着），
+// 就停在它这一层。
+func NEXUnwrap(c net.Conn) net.Conn {
+	for {
+		u, ok := c.(interface{ NEXUnwrap() net.Conn })
+		if !ok {
+			return c
+		}
+		inner := u.NEXUnwrap()
+		if inner == nil {
+			return c
+		}
+		c = inner
+	}
+}
+
+// NEXSplicePair 两条连接剥掉空转的包装层后都是 *net.TCPConn 时把它们交出来：Go 对两条
+// *net.TCPConn 之间的 io.Copy 走 splice(2)，数据在内核里搬，不进进程的缓冲区。任何一条
+// 剥不干净（TLS、WebSocket、限速、PROXY 头接收、嗅探缓冲……）都返回 false，调用方照旧走
+// 原来的包装连接。
+func NEXSplicePair(a, b net.Conn) (*net.TCPConn, *net.TCPConn, bool) {
+	ta, ok := NEXUnwrap(a).(*net.TCPConn)
+	if !ok {
+		return nil, nil, false
+	}
+	tb, ok := NEXUnwrap(b).(*net.TCPConn)
+	if !ok {
+		return nil, nil, false
+	}
+	return ta, tb, true
+}
diff --git a/metrics/wrapper/nex_unwrap.go b/metrics/wrapper/nex_unwrap.go
--- /dev/null
+++ b/metrics/wrapper/nex_unwrap.go
@@ -0,0 +1,16 @@
+package wrapper
+
+import (
+	"net"
+
+	xmetrics "github.com/go-gost/x/metrics"
+)
+
+// NEXUnwrap 让 NEX 的补丁拿到底层 TCP 连接、直接走 splice。只有没开 metrics 时这一层才是空转、
+// 可以被绕过；开了 metrics 就返回 nil，连接照旧走用户态，计数不丢。
+func (c *serverConn) NEXUnwrap() net.Conn {
+	if xmetrics.IsEnabled() {
+		return nil
+	}
+	return c.Conn
+}
