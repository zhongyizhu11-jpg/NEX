{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "client/src/lib/avataaarsLodashShim.ts",
    "scripts/*.mjs",
    "server/*.fixture.ts",
    "{server,shared,client/src,scripts}/**/*.test.{ts,tsx}",
    "docs/.vitepress/config.mts",
    "docs/.vitepress/theme/index.ts",
    "e2e/scenario.ts"
  ],
  "project": [
    "client/src/**/*.{ts,tsx}",
    "server/**/*.ts",
    "shared/**/*.ts",
    "drizzle/**/*.ts",
    "scripts/**/*.{ts,mjs}",
    "docs/.vitepress/**/*.{ts,mts}",
    "e2e/**/*.ts"
  ],
  "ignoreBinaries": [
    "convert",
    "openssl",
    "go",
    "ip"
  ]
}
